{
  "manifest_version": 3,
  "name": "Claude Speak",
  "version": "1.0.0",
  "description": "Speaks Claude session content aloud as it appears.",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "ws-hook.js",
        "http-tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Claude Speak"
  },
  "background": {
    "service_worker": "background.js"
  }
}
